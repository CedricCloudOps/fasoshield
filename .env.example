# FasoShield configuration (12-factor, prefix FASOSHIELD_)

# -- Agents ------------------------------------------------------------------
# Comma-separated API keys for mobile agents; empty disables auth (dev only).
# These keys never grant access to the console, the statistics or the exports.
FASOSHIELD_API_KEYS=

# EC P-256 private key signing the signature bundles agents apply, created by
# `fasoshield keys generate`. Empty serves unsigned bundles, which only a
# development build of the agent accepts.
FASOSHIELD_SIGNATURE_SIGNING_KEY=

# -- Storage -----------------------------------------------------------------
# PostgreSQL in production; empty falls back to a local SQLite file.
FASOSHIELD_DATABASE_URL=

# Quarantine backend: empty = <data_dir>/quarantine, or a file:// / s3:// URL.
# Object storage becomes mandatory as soon as several API instances run.
#FASOSHIELD_QUARANTINE_URL=s3://fasoshield-quarantine/samples

# Storage locations (defaults are relative to the project root).
#FASOSHIELD_DATA_DIR=/var/lib/fasoshield
#FASOSHIELD_SIGNATURES_DIR=/etc/fasoshield/signatures

# -- Scanning ----------------------------------------------------------------
# Hard cap for POST /v1/scan (bytes).
#FASOSHIELD_MAX_UPLOAD_BYTES=209715200
# Uploads above this size are queued instead of being scanned inline.
#FASOSHIELD_ASYNC_SCAN_THRESHOLD_BYTES=16777216

# -- Analyst identity --------------------------------------------------------
#FASOSHIELD_SESSION_TTL_MINUTES=720
# Set to false only for plain-HTTP local development, otherwise the browser
# will never send the session cookie back.
#FASOSHIELD_SESSION_COOKIE_SECURE=true

# Header-based SSO, for an OIDC gateway terminating authentication in front of
# the API. ONLY safe when the API is unreachable except through that gateway —
# read docs/DEPLOIEMENT.md before enabling it.
#FASOSHIELD_SSO_USER_HEADER=X-Auth-User
#FASOSHIELD_SSO_ROLE_HEADER=X-Auth-Role
#FASOSHIELD_SSO_DEFAULT_ROLE=viewer

# -- Threat intelligence sharing ---------------------------------------------
#FASOSHIELD_INTEL_ORG_NAME=FasoShield — CERT national
#FASOSHIELD_INTEL_TLP=amber

# -- Hardening ---------------------------------------------------------------
#FASOSHIELD_RATE_LIMIT_PER_MINUTE=120
#FASOSHIELD_RATE_LIMIT_BURST=30
#FASOSHIELD_HSTS_ENABLED=true
# Comma-separated origins; empty means no cross-origin access at all.
#FASOSHIELD_CORS_ORIGINS=
# Exact number of reverse proxies in front of the API. Too high a value would
# let a caller forge the client address recorded in the audit trail.
#FASOSHIELD_TRUSTED_PROXY_COUNT=1
