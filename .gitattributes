# Normalise line endings for text, and never touch binaries.
* text=auto

# Generated presentation assets. Git's content heuristic classifies these
# correctly today, but marking them explicitly means a clone on a machine with
# core.autocrlf=true can never corrupt them.
*.pdf binary
*.png binary
*.jpg binary
*.jks binary
*.keystore binary

# Shell scripts must keep LF even when checked out on Windows, otherwise the
# Gradle wrapper breaks on a Unix build agent.
gradlew text eol=lf
*.sh text eol=lf
